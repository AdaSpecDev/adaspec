diff --git a/vllm/v1/adaspec_trace.py b/vllm/v1/adaspec_trace.py
new file mode 100644
index 0000000000..962cf226bf
--- /dev/null
+++ b/vllm/v1/adaspec_trace.py
@@ -0,0 +1,119 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Opt-in synchronous pilot tracing; disabled unless ADASPEC_TRACE_DIR is set."""
+
+import json
+import os
+import time
+from pathlib import Path
+
+
+def capture_schedule(scheduler, output):
+    if not os.environ.get("ADASPEC_TRACE_DIR"):
+        return
+    step = getattr(scheduler, "_adaspec_step", 0) + 1
+    scheduler._adaspec_step = step
+    requests = []
+    for request_id, query_tokens in output.num_scheduled_tokens.items():
+        request = scheduler.requests[request_id]
+        groups = scheduler.kv_cache_manager.get_block_ids(request_id)
+        requests.append(
+            {
+                "request_id": request_id,
+                "cached_tokens": request.num_computed_tokens,
+                "prompt_tokens": request.num_prompt_tokens,
+                "query_tokens": query_tokens,
+                "draft_tokens": len(
+                    output.scheduled_spec_decode_tokens.get(request_id, [])
+                ),
+                "allocated_blocks_by_group": [len(group) for group in groups],
+                "has_prefill": request.num_computed_tokens < request.num_prompt_tokens,
+            }
+        )
+    output.adaspec_metadata = {
+        "step": step,
+        "schedule_capture_perf_counter": time.perf_counter(),
+        "requests": requests,
+        "preempted_request_ids": sorted(output.preempted_req_ids or []),
+    }
+
+
+class TargetTimer:
+    """Measure target transformer forward, excluding logits and rejection sampling."""
+
+    def __init__(self, runner, output):
+        self.metadata = output.adaspec_metadata
+        self.runner = runner
+        self.enabled = self.metadata is not None
+
+    def start(self):
+        if not self.enabled:
+            return
+        import torch
+
+        # Pilot deliberately synchronizes to make the timing boundary unambiguous.
+        torch.cuda.synchronize()
+        self.start_event = torch.cuda.Event(enable_timing=True)
+        self.end_event = torch.cuda.Event(enable_timing=True)
+        self.wall_start = time.perf_counter()
+        self.start_event.record()
+
+    def finish(self):
+        if not self.enabled:
+            return
+        self.end_event.record()
+        self.end_event.synchronize()
+        wall_ms = (time.perf_counter() - self.wall_start) * 1000
+        ids = list(self.runner.input_batch.req_ids)
+        cached = self.runner.input_batch.num_computed_tokens_cpu[: len(ids)]
+        by_id = {row["request_id"]: row for row in self.metadata["requests"]}
+        rows = []
+        for index, request_id in enumerate(ids):
+            row = dict(by_id[request_id])
+            row["worker_cached_tokens"] = int(cached[index])
+            row["attention_sequence_tokens"] = (
+                row["worker_cached_tokens"] + row["query_tokens"]
+            )
+            rows.append(row)
+        event = {
+            **self.metadata,
+            "schema_version": 1,
+            "event": "target_forward",
+            "requests": rows,
+            "batch_size": len(rows),
+            "target_forward_gpu_ms": self.start_event.elapsed_time(self.end_event),
+            "target_forward_wall_ms": wall_ms,
+            "pid": os.getpid(),
+            "timing_scope": "target_transformer_forward_excluding_logits",
+        }
+        path = Path(os.environ["ADASPEC_TRACE_DIR"])
+        path.mkdir(parents=True, exist_ok=True)
+        with (path / f"target-{os.getpid()}.jsonl").open("a") as stream:
+            stream.write(json.dumps(event) + "\n")
+
+
+def capture_feedback(output, request_id, generated_token_ids):
+    if output.adaspec_metadata is None:
+        return
+    draft_tokens = len(output.scheduled_spec_decode_tokens.get(request_id, []))
+    event = {
+        "schema_version": 1,
+        "event": "verification_feedback",
+        "step": output.adaspec_metadata["step"],
+        "request_id": request_id,
+        "draft_tokens": draft_tokens,
+        "returned_token_count": len(generated_token_ids),
+        "accepted_draft_tokens": (
+            len(generated_token_ids) - 1
+            if draft_tokens and generated_token_ids
+            else None
+        ),
+        "schedule_to_feedback_wall_ms": (
+            time.perf_counter()
+            - output.adaspec_metadata["schedule_capture_perf_counter"]
+        )
+        * 1000,
+    }
+    path = Path(os.environ["ADASPEC_TRACE_DIR"])
+    path.mkdir(parents=True, exist_ok=True)
+    with (path / f"feedback-{os.getpid()}.jsonl").open("a") as stream:
+        stream.write(json.dumps(event) + "\n")
